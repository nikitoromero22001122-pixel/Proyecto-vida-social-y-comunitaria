<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Simulador Interactivo: Un día en 2020 · Vida social y comunitaria</title>
  <style>
    :root {
      --bg-dark: #070d19;
      --bg-card: #111b2e;
      --bg-card-soft: #192741;
      --bg-pill: #0c1526;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --accent-cyan: #38bdf8;
      --accent-indigo: #818cf8;
      --accent-emerald: #34d399;
      --accent-amber: #fbbf24;
      --accent-rose: #fb7185;
      --border-subtle: rgba(148, 163, 184, 0.16);
      --shadow-heavy: 0 24px 60px rgba(0, 0, 0, 0.55);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background:
        radial-gradient(circle at 15% 10%, rgba(56, 189, 248, 0.14), transparent 35%),
        radial-gradient(circle at 85% 20%, rgba(129, 140, 248, 0.14), transparent 40%),
        var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      line-height: 1.55;
      padding: 24px 16px 48px;
    }

    .app-shell {
      max-width: 1080px;
      margin: 0 auto;
    }

    /* Encabezado principal */
    .hero {
      background: linear-gradient(135deg, rgba(17, 27, 46, 0.96), rgba(25, 39, 65, 0.92));
      border: 1px solid var(--border-subtle);
      border-radius: 22px;
      padding: 28px 32px;
      box-shadow: var(--shadow-heavy);
      margin-bottom: 22px;
    }

    .hero-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(56, 189, 248, 0.14);
      color: var(--accent-cyan);
      border: 1px solid rgba(56, 189, 248, 0.35);
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.4px;
    }

    .hero-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn-ghost {
      background: var(--bg-pill);
      color: var(--text-main);
      border: 1px solid var(--border-subtle);
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: border-color 0.2s, transform 0.15s;
    }

    .btn-ghost:hover {
      border-color: var(--accent-cyan);
      transform: translateY(-1px);
    }

    .hero h1 {
      font-size: clamp(1.6rem, 3.2vw, 2.35rem);
      font-weight: 800;
      margin-bottom: 10px;
      letter-spacing: -0.02em;
    }

    .hero p {
      color: var(--text-muted);
      font-size: 1rem;
      max-width: 820px;
    }

    /* Selector de momentos del día */
    .timeline-nav {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      margin-bottom: 22px;
    }

    .time-slot-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 14px 12px;
      color: var(--text-muted);
      cursor: pointer;
      text-align: left;
      transition: all 0.2s ease;
      position: relative;
    }

    .time-slot-btn:hover {
      border-color: rgba(56, 189, 248, 0.5);
      color: var(--text-main);
    }

    .time-slot-btn.active {
      background: linear-gradient(160deg, rgba(56, 189, 248, 0.18), rgba(129, 140, 248, 0.12));
      border-color: var(--accent-cyan);
      color: var(--text-main);
      box-shadow: 0 10px 24px rgba(14, 165, 233, 0.18);
    }

    .time-slot-btn.visited::after {
      content: "✓";
      position: absolute;
      top: 10px;
      right: 12px;
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--accent-emerald);
    }

    .slot-hour {
      display: block;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--accent-cyan);
      margin-bottom: 3px;
    }

    .slot-title {
      display: block;
      font-size: 0.92rem;
      font-weight: 700;
    }

    /* Grilla principal: Escena + Indicadores del día */
    .main-grid {
      display: grid;
      grid-template-columns: 1.65fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .panel {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      padding: 26px;
      box-shadow: var(--shadow-heavy);
    }

    .scene-kicker {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent-indigo);
      font-weight: 800;
      margin-bottom: 6px;
    }

    .scene-heading {
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .scene-context {
      color: #cbd5e1;
      font-size: 0.98rem;
      margin-bottom: 20px;
      background: var(--bg-pill);
      padding: 16px;
      border-radius: 14px;
      border-left: 4px solid var(--accent-cyan);
    }

    .choices-label {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 12px;
    }

    .choices-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }

    .choice-card {
      background: var(--bg-card-soft);
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 14px;
      padding: 15px 18px;
      color: var(--text-main);
      text-align: left;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .choice-card:hover {
      border-color: var(--accent-cyan);
      transform: translateX(3px);
    }

    .choice-card.selected {
      background: rgba(56, 189, 248, 0.16);
      border-color: var(--accent-cyan);
      box-shadow: 0 0 0 1px var(--accent-cyan);
    }

    .choice-title {
      font-weight: 700;
      font-size: 1rem;
      display: block;
      margin-bottom: 4px;
    }

    .choice-sub {
      font-size: 0.86rem;
      color: var(--text-muted);
      display: block;
    }

    .outcome-box {
      background: var(--bg-pill);
      border: 1px solid rgba(52, 211, 153, 0.35);
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 20px;
    }

    .outcome-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--accent-emerald);
      margin-bottom: 6px;
    }

    .outcome-text {
      font-size: 0.95rem;
      color: #e2e8f0;
      margin-bottom: 10px;
    }

    .tags-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .mini-tag {
      font-size: 0.78rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(129, 140, 248, 0.16);
      color: #c7d2fe;
      border: 1px solid rgba(129, 140, 248, 0.35);
    }

    .scene-footer-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--border-subtle);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent-cyan), var(--accent-indigo));
      color: #061024;
      border: none;
      border-radius: 12px;
      padding: 11px 20px;
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.15s;
    }

    .btn-primary:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: var(--bg-card-soft);
      color: var(--text-main);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 11px 18px;
      font-size: 0.92rem;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-secondary:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* Panel lateral: Estado emocional, vínculo comunitario y bitácora */
    .meter-block {
      margin-bottom: 18px;
    }

    .meter-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.86rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .meter-track {
      height: 10px;
      background: var(--bg-pill);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid var(--border-subtle);
    }

    .meter-fill {
      height: 100%;
      width: 50%;
      border-radius: 999px;
      transition: width 0.35s ease;
    }

    .fill-comunidad {
      background: linear-gradient(90deg, var(--accent-emerald), var(--accent-cyan));
    }

    .fill-digital {
      background: linear-gradient(90deg, var(--accent-indigo), var(--accent-cyan));
    }

    .fill-carga {
      background: linear-gradient(90deg, var(--accent-amber), var(--accent-rose));
    }

    .log-section h3 {
      font-size: 0.95rem;
      font-weight: 800;
      margin-bottom: 10px;
      color: var(--accent-cyan);
    }

    .log-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 250px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .log-item {
      background: var(--bg-pill);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.84rem;
      color: #cbd5e1;
    }

    .log-item strong {
      color: var(--text-main);
      display: block;
      margin-bottom: 2px;
    }

    /* Bloque inferior: Reflexión y cierre de exposición */
    .reflection-panel {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      padding: 24px 28px;
      box-shadow: var(--shadow-heavy);
    }

    .reflection-panel h2 {
      font-size: 1.2rem;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .reflection-panel p {
      color: var(--text-muted);
      font-size: 0.92rem;
      margin-bottom: 14px;
    }

    .notes-area {
      width: 100%;
      min-height: 84px;
      background: var(--bg-pill);
      color: var(--text-main);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 0.92rem;
      resize: vertical;
      margin-bottom: 12px;
    }

    .notes-area:focus {
      outline: none;
      border-color: var(--accent-cyan);
    }

    .save-status {
      font-size: 0.82rem;
      color: var(--accent-emerald);
      margin-left: 12px;
    }

    @media (max-width: 860px) {
      .timeline-nav {
        grid-template-columns: repeat(2, 1fr);
      }
      .main-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 520px) {
      .timeline-nav {
        grid-template-columns: 1fr;
      }
      .hero, .panel, .reflection-panel {
        padding: 20px;
      }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <header class="hero">
      <div class="hero-top">
        <span class="badge">SIMULADOR INTERACTIVO · PANDEMIA 2020</span>
        <div class="hero-actions">
          <button class="btn-ghost" type="button" onclick="reiniciarSimulador()">↺ Reiniciar día</button>
          <button class="btn-ghost" type="button" onclick="window.print()">🖨 Imprimir guía</button>
        </div>
      </div>
      <h1>Un día en 2020: convivencia, pantallas y comunidad</h1>
      <p>
        Recorré cinco momentos de una jornada durante el aislamiento preventivo en Argentina. Elegí cómo se
        desarrolla cada situación para analizar la educación virtual, las redes y los juegos, las emociones,
        los protocolos en la calle y la solidaridad entre vecinos.
      </p>
    </header>

    <nav class="timeline-nav" aria-label="Momentos del día" id="timeline-nav"></nav>

    <div class="main-grid">
      <main class="panel" id="scene-panel">
        <div class="scene-kicker" id="scene-kicker">Momento 1 de 5</div>
        <h2 class="scene-heading" id="scene-heading">Cargando escena...</h2>
        <div class="scene-context" id="scene-context"></div>

        <div class="choices-label">Elegí una opción para ver cómo impacta en el día:</div>
        <div class="choices-list" id="choices-list"></div>

        <div class="outcome-box" id="outcome-box">
          <div class="outcome-title" id="outcome-title">Análisis de la situación</div>
          <p class="outcome-text" id="outcome-text"></p>
          <div class="tags-row" id="outcome-tags"></div>
        </div>

        <div class="scene-footer-nav">
          <button class="btn-secondary" type="button" id="btn-prev" onclick="moverEscena(-1)">← Momento anterior</button>
          <button class="btn-primary" type="button" id="btn-next" onclick="moverEscena(1)">Siguiente momento →</button>
        </div>
      </main>

      <aside class="panel">
        <h2 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 16px;">Termómetro de la jornada</h2>

        <div class="meter-block">
          <div class="meter-header">
            <span>Lazo y solidaridad comunitaria</span>
            <span id="val-comunidad">50%</span>
          </div>
          <div class="meter-track">
            <div class="meter-fill fill-comunidad" id="bar-comunidad"></div>
          </div>
        </div>

        <div class="meter-block">
          <div class="meter-header">
            <span>Dependencia digital y pantallas</span>
            <span id="val-digital">50%</span>
          </div>
          <div class="meter-track">
            <div class="meter-fill fill-digital" id="bar-digital"></div>
          </div>
        </div>

        <div class="meter-block">
          <div class="meter-header">
            <span>Tensión, encierro y fatiga</span>
            <span id="val-carga">50%</span>
          </div>
          <div class="meter-track">
            <div class="meter-fill fill-carga" id="bar-carga"></div>
          </div>
        </div>

        <div class="log-section">
          <h3>Bitácora de decisiones del día</h3>
          <ul class="log-list" id="log-list">
            <li class="log-item">
              <strong>Inicio de la simulación</strong>
              Seleccioná una opción en cada momento del día para registrar lo ocurrido.
            </li>
          </ul>
        </div>
      </aside>
    </div>

    <section class="reflection-panel">
      <h2>Notas para la exposición grupal y conclusión</h2>
      <p>
        Escribí acá las ideas clave que quieren destacar al cerrar (por ejemplo, qué herramientas digitales siguen
        usándose hoy y por qué la ayuda mutua sostuvo a la comunidad cuando faltó el encuentro presencial).
      </p>
      <textarea
        class="notes-area"
        id="group-notes"
        placeholder="Anotá ejemplos de su barrio, escuela o experiencia personal..."
        oninput="guardarNotas()"
      ></textarea>
      <div>
        <button class="btn-secondary" type="button" onclick="cargarEjemploConclusion()">Completar borrador de cierre</button>
        <span class="save-status" id="save-status"></span>
      </div>
    </section>
  </div>

  <script>
    const escenas = [
      {
        id: "manana-escuela",
        hora: "09:00 · Mañana",
        tituloCorto: "Clases y virtualidad",
        kicker: "Momento 1 de 5 · Educación y hogar",
        encabezado: "La escuela desde casa: tareas, Zoom y brecha digital",
        contexto:
          "Desde mediados de marzo de 2020, las escuelas cerraron y los encuentros presenciales se suspendieron. En muchos hogares la jornada empieza frente a una pantalla, mientras que en otros faltan dispositivos o buena conexión a internet.",
        opciones: [
          {
            titulo: "Clase por Zoom y envío de tareas en fotos",
            sub: "Conectarse con cámara y micrófono para seguir las consignas y devolver actividades.",
            comunidad: 55,
            digital: 82,
            carga: 58,
            resumenLog: "Mañana: clases por Zoom y fotos de tareas escolares.",
            resultadoTitulo: "Continuidad con cansancio de pantalla",
            resultadoTexto:
              "Pasar de copiar tareas enviadas en fotos a conectarse por videollamada permitió mantener el vínculo escolar, aunque estar horas frente a una pantalla también generó agotamiento y distancia con los compañeros.",
            etiquetas: ["Virtualidad", "Fotos y Zoom", "Cambio escolar"]
          },
          {
            titulo: "Dificultad por falta de internet o un solo celular",
            sub: "Compartir el teléfono de la familia o esperar datos móviles para descargar consignas.",
            comunidad: 48,
            digital: 45,
            carga: 78,
            resumenLog: "Mañana: dificultades de conexión y dispositivos compartidos.",
            resultadoTitulo: "Obstáculos para sostener la continuidad",
            resultadoTexto:
              "La falta de internet estable o de computadoras y celulares propios en muchos hogares dificultó seguir el ritmo escolar y puso en evidencia desigualdades de acceso durante el aislamiento.",
            etiquetas: ["Brecha digital", "Conectividad", "Desafío educativo"]
          }
        ]
      },
      {
        id: "mediodia-calle",
        hora: "12:30 · Mediodía",
        tituloCorto: "La calle y las compras",
        kicker: "Momento 2 de 5 · Nuevos hábitos y cuidado",
        encabezado: "Salir a comprar: barbijo, calles vacías y desinfección",
        contexto:
          "Salir del hogar deja de ser un trámite automático. En la calle se notan menos personas y vehículos, los comercios tienen góndolas cubiertas con plásticos y cada paso exige nuevos cuidados sanitarios.",
        opciones: [
          {
            titulo: "Protocolo estricto al salir y al volver a casa",
            sub: "Usar barbijo, aplicar alcohol en gel al pagar y desinfectar bolsas y productos al entrar.",
            comunidad: 62,
            digital: 52,
            carga: 68,
            resumenLog: "Mediodía: barbijo, alcohol en gel y desinfección de compras.",
            resultadoTitulo: "Nuevos rituales de prevención cotidiana",
            resultadoTexto:
              "El barbijo, las góndolas protegidas con plásticos, el alcohol en gel al pagar y la limpieza de bolsas y envases al llegar a casa se volvieron parte de la rutina diaria para reducir riesgos.",
            etiquetas: ["Barbijo", "Alcohol en gel", "Desinfección"]
          },
          {
            titulo: "Compra rápida y coordinada por mensajería",
            sub: "Consultar precios y encargos por chat para reducir el tiempo fuera de casa.",
            comunidad: 60,
            digital: 74,
            carga: 56,
            resumenLog: "Mediodía: compras coordinadas por mensaje y salida breve.",
            resultadoTitulo: "Menos circulación y más organización previa",
            resultadoTexto:
              "Planificar desde el celular antes de salir ayudó a acortar recorridos en calles poco transitadas, aunque la rutina seguía marcada por la distancia y la precaución.",
            etiquetas: ["Calles vacías", "Prevención", "Rutina urbana"]
          }
        ]
      },
      {
        id: "tarde-redes-juegos",
        hora: "16:30 · Tarde",
        tituloCorto: "Juegos y redes",
        kicker: "Momento 3 de 5 · Cultura digital y ocio",
        encabezado: "Tarde de pantallas: videojuegos multijugador, videos y foros",
        contexto:
          "Sin plazas ni encuentros presenciales habituales, la tarde encuentra a muchos chicos y jóvenes en entornos digitales para entretenerse, compartir tendencias o resolver dudas con otras personas.",
        opciones: [
          {
            titulo: "Partidas con amigos en Free Fire, Roblox o Stumble Guys",
            sub: "Reunirse en línea para jugar y charlar mientras dura el aislamiento.",
            comunidad: 68,
            digital: 88,
            carga: 46,
            resumenLog: "Tarde: partidas en Free Fire, Roblox o Stumble Guys.",
            resultadoTitulo: "El juego online como punto de encuentro",
            resultadoTexto:
              "Títulos como Free Fire, Roblox y Stumble Guys cumplieron un rol social clave: permitieron compartir risas, armar equipos y mantener el contacto con amigos cuando no era posible verse en persona.",
            etiquetas: ["Free Fire", "Roblox", "Stumble Guys"]
          },
          {
            titulo: "Recorrer TikTok, Instagram y comunidades de Reddit",
            sub: "Mirar videos cortos e historias, y consultar en Reddit cómo resolver tareas o dudas.",
            comunidad: 65,
            digital: 86,
            carga: 50,
            resumenLog: "Tarde: TikTok, Instagram y ayuda mutua en Reddit.",
            resultadoTitulo: "Tendencias, expresión y ayuda colaborativa",
            resultadoTexto:
              "TikTok e Instagram concentraron gran parte del entretenimiento y los formatos breves, mientras que en Reddit muchas personas se ayudaban entre sí para resolver cuestiones cotidianas o aprender cosas nuevas.",
            etiquetas: ["TikTok", "Instagram", "Reddit"]
          }
        ]
      },
      {
        id: "atardecer-emociones",
        hora: "19:30 · Atardecer",
        tituloCorto: "Emociones y vínculos",
        kicker: "Momento 4 de 5 · Consecuencias emocionales",
        encabezado: "El peso de la distancia: tristeza, ansiedad, soledad y charla",
        contexto:
          "Al caer la tarde, cuando termina la actividad del día, aparecen con más fuerza las emociones que dejó el aislamiento: extrañar abrazos, sentirse solo o sentir incertidumbre frente a lo que pasa.",
        opciones: [
          {
            titulo: "Hablar con familia o amistades sobre cómo uno se siente",
            sub: "Compartir lo que cuesta del encierro y acompañar a alguien que está pasando un mal momento.",
            comunidad: 76,
            digital: 68,
            carga: 52,
            resumenLog: "Atardecer: poner en palabras las emociones y acompañar.",
            resultadoTitulo: "Nombrar lo que pasa ayuda a aliviar la carga",
            resultadoTexto:
              "Reconocer la tristeza, la ansiedad o la soledad —en vez de ocultarlas— permitió sostener los vínculos afectivos y recordar que esas emociones eran compartidas por muchas personas.",
            etiquetas: ["Emociones", "Acompañamiento", "Vínculos"]
          },
          {
            titulo: "Guardar el malestar y evitar el contacto",
            sub: "Cerrar la jornada en silencio sintiendo distancia con el entorno.",
            comunidad: 40,
            digital: 60,
            carga: 84,
            resumenLog: "Atardecer: sensación de soledad y distancia emocional.",
            resultadoTitulo: "Cuando el aislamiento pesa más",
            resultadoTexto:
              "El encierro prolongado y la falta de encuentros cara a cara intensificaron el cansancio emocional y la soledad en muchas personas, mostrando lo difícil que fue sostener el ánimo día tras día.",
            etiquetas: ["Soledad", "Ansiedad", "Fatiga del aislamiento"]
          }
        ]
      },
      {
        id: "noche-solidaridad",
        hora: "21:30 · Noche",
        tituloCorto: "Solidaridad vecinal",
        kicker: "Momento 5 de 5 · Comunidad y cierre",
        encabezado: "Ayuda mutua en el barrio: cuidar a quienes lo necesitan",
        contexto:
          "En el barrio se sabe que un vecino mayor o una familia con dificultades necesita mercadería o medicamentos. La noche cierra mostrando cómo responde la comunidad frente a la necesidad.",
        opciones: [
          {
            titulo: "Acercar mercadería o medicamentos y desinfectar las bolsas",
            sub: "Colaborar con los vecinos —por ejemplo, desinfectando con alcohol y agua— para cuidar a todos.",
            comunidad: 94,
            digital: 64,
            carga: 44,
            resumenLog: "Noche: ayuda vecinal con mercadería, remedios y desinfección.",
            resultadoTitulo: "La solidaridad comunitaria como sostén",
            resultadoTexto:
              "Acercar compras o medicamentos y desinfectar las bolsas —usando, por caso, una mezcla de alcohol y agua— reflejó el valor de la ayuda mutua: cuando faltó el encuentro habitual, la solidaridad sostuvo a la sociedad.",
            etiquetas: ["Solidaridad comunitaria", "Cuidado mutuo", "Barrio"]
          },
          {
            titulo: "Organizar una red de apoyo entre vecinos y conocidos",
            sub: "Coordinar turnos para consultar qué hace falta y asistir sin exponerse de más.",
            comunidad: 88,
            digital: 72,
            carga: 48,
            resumenLog: "Noche: red solidaria organizada para asistir a vecinos.",
            resultadoTitulo: "Participación comunitaria responsable",
            resultadoTexto:
              "Preocuparse por las necesidades de los demás y organizarse con cuidado demostró que la vida en sociedad se fortalece cuando la cooperación acompaña a la responsabilidad colectiva.",
            etiquetas: ["Participación", "Red solidaria", "Responsabilidad"]
          }
        ]
      }
    ];

    let escenaActual = 0;
    const selecciones = new Array(escenas.length).fill(null);
    const visitadas = new Set([0]);

    const navEl = document.getElementById("timeline-nav");
    const kickerEl = document.getElementById("scene-kicker");
    const headingEl = document.getElementById("scene-heading");
    const contextEl = document.getElementById("scene-context");
    const choicesEl = document.getElementById("choices-list");
    const outcomeBoxEl = document.getElementById("outcome-box");
    const outcomeTitleEl = document.getElementById("outcome-title");
    const outcomeTextEl = document.getElementById("outcome-text");
    const outcomeTagsEl = document.getElementById("outcome-tags");
    const btnPrevEl = document.getElementById("btn-prev");
    const btnNextEl = document.getElementById("btn-next");
    const logListEl = document.getElementById("log-list");
    const notesEl = document.getElementById("group-notes");
    const saveStatusEl = document.getElementById("save-status");

    function renderNavegacion() {
      navEl.innerHTML = "";
      escenas.forEach((escena, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "time-slot-btn";
        if (idx === escenaActual) btn.classList.add("active");
        if (visitadas.has(idx) && selecciones[idx] !== null) btn.classList.add("visited");

        btn.innerHTML = `
          <span class="slot-hour">${escena.hora}</span>
          <span class="slot-title">${escena.tituloCorto}</span>
        `;
        btn.onclick = () => {
          escenaActual = idx;
          visitadas.add(idx);
          renderTodo();
        };
        navEl.appendChild(btn);
      });
    }

    function renderEscena() {
      const escena = escenas[escenaActual];
      kickerEl.textContent = escena.kicker;
      headingEl.textContent = escena.encabezado;
      contextEl.textContent = escena.contexto;

      choicesEl.innerHTML = "";
      escena.opciones.forEach((op, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "choice-card";
        if (selecciones[escenaActual] === idx) btn.classList.add("selected");

        btn.innerHTML = `
          <span class="choice-title">${op.titulo}</span>
          <span class="choice-sub">${op.sub}</span>
        `;
        btn.onclick = () => elegirOpcion(idx);
        choicesEl.appendChild(btn);
      });

      const elegidaIdx = selecciones[escenaActual];
      if (elegidaIdx === null) {
        outcomeTitleEl.textContent = "Aún no elegiste una opción en este momento";
        outcomeTextEl.textContent =
          "Seleccioná una de las alternativas de arriba para ver cómo se vivió esa situación y cómo impactó en los indicadores del día.";
        outcomeTagsEl.innerHTML = `<span class="mini-tag">Esperando selección</span>`;
      } else {
        const op = escena.opciones[elegidaIdx];
        outcomeTitleEl.textContent = op.resultadoTitulo;
        outcomeTextEl.textContent = op.resultadoTexto;
        outcomeTagsEl.innerHTML = op.etiquetas
          .map((tag) => `<span class="mini-tag">${tag}</span>`)
          .join("");
      }

      btnPrevEl.disabled = escenaActual === 0;
      btnNextEl.textContent =
        escenaActual === escenas.length - 1 ? "Ir al inicio del día ↺" : "Siguiente momento →";
    }

    function elegirOpcion(idx) {
      selecciones[escenaActual] = idx;
      renderTodo();
    }

    function calcularPromedios() {
      const elegidas = escenas
        .map((esc, i) => (selecciones[i] !== null ? esc.opciones[selecciones[i]] : null))
        .filter(Boolean);

      if (elegidas.length === 0) {
        return { comunidad: 50, digital: 50, carga: 50 };
      }

      const suma = elegidas.reduce(
        (acc, item) => {
          acc.comunidad += item.comunidad;
          acc.digital += item.digital;
          acc.carga += item.carga;
          return acc;
        },
        { comunidad: 0, digital: 0, carga: 0 }
      );

      return {
        comunidad: Math.round(suma.comunidad / elegidas.length),
        digital: Math.round(suma.digital / elegidas.length),
        carga: Math.round(suma.carga / elegidas.length)
      };
    }

    function renderTermometros() {
      const { comunidad, digital, carga } = calcularPromedios();

      document.getElementById("val-comunidad").textContent = `${comunidad}%`;
      document.getElementById("bar-comunidad").style.width = `${comunidad}%`;

      document.getElementById("val-digital").textContent = `${digital}%`;
      document.getElementById("bar-digital").style.width = `${digital}%`;

      document.getElementById("val-carga").textContent = `${carga}%`;
      document.getElementById("bar-carga").style.width = `${carga}%`;
    }

    function renderBitacora() {
      const entradas = escenas
        .map((esc, i) => {
          const sel = selecciones[i];
          if (sel === null) return null;
          return {
            hora: esc.hora,
            texto: esc.opciones[sel].resumenLog
          };
        })
        .filter(Boolean);

      if (entradas.length === 0) {
        logListEl.innerHTML = `
          <li class="log-item">
            <strong>Sin decisiones registradas aún</strong>
            Elegí una opción en cualquiera de los cinco momentos del día para armar la bitácora.
          </li>
        `;
        return;
      }

      logListEl.innerHTML = entradas
        .map(
          (entry) => `
          <li class="log-item">
            <strong>${entry.hora}</strong>
            ${entry.texto}
          </li>
        `
        )
        .join("");
    }

    function moverEscena(delta) {
      if (delta === 1 && escenaActual === escenas.length - 1) {
        escenaActual = 0;
      } else {
        escenaActual = Math.max(0, Math.min(escenas.length - 1, escenaActual + delta));
      }
      visitadas.add(escenaActual);
      renderTodo();
    }

    function reiniciarSimulador() {
      escenaActual = 0;
      selecciones.fill(null);
      visitadas.clear();
      visitadas.add(0);
      renderTodo();
    }

    function guardarNotas() {
      try {
        localStorage.setItem("simulador2020Notas", notesEl.value);
        saveStatusEl.textContent = "Guardado en el navegador";
      } catch (e) {
        saveStatusEl.textContent = "";
      }
    }

    function cargarNotas() {
      try {
        const guardadas = localStorage.getItem("simulador2020Notas");
        if (guardadas) {
          notesEl.value = guardadas;
        }
      } catch (e) {
        // Ignorar si localStorage no está disponible
      }
    }

    function cargarEjemploConclusion() {
      notesEl.value =
        "En 2020 la suspensión de eventos y el cierre de escuelas impulsaron la virtualidad (fotos de tareas, Zoom), juegos como Free Fire, Roblox y Stumble Guys y redes como TikTok, Instagram y Reddit. También hubo emociones difíciles y nuevos hábitos (barbijo, alcohol en gel, desinfección), pero la solidaridad comunitaria —como acercar mercadería o medicamentos y desinfectar bolsas— fue clave para cuidarnos.";
      guardarNotas();
    }

    function renderTodo() {
      renderNavegacion();
      renderEscena();
      renderTermometros();
      renderBitacora();
    }

    cargarNotas();
    renderTodo();
  </script>
</body>
</html>
